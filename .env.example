# Private Solana RPC URL (Helius, QuickNode, Alchemy, etc.)
# Set this in your hosting provider — never commit the real value.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# ManGo Snake high-score API on Hetzner bot server (public URL, no secrets)
# Use exactly: https://api.mangomeme.fun/snake-highscore
# Leave empty to disable score sharing in the game UI.
VITE_MANGO_HIGHSCORE_API_URL=https://api.mangomeme.fun/snake-highscore

# ManGo Bounch high-score API on Hetzner bot server (public URL, no secrets)
# Use exactly: https://api.mangomeme.fun/bounch-highscore
# Leave empty to disable Bounch score sharing (game still works fully locally).
VITE_MANGO_BOUNCH_HIGHSCORE_API_URL=https://api.mangomeme.fun/bounch-highscore

# ManGo Telegram ↔ Solana wallet verification API (Hetzner highscore server origin)
# Use exactly: https://api.mangomeme.fun
# Frontend posts to /wallet/challenge and /wallet/verify. HTTPS required in production.
VITE_MANGO_WALLET_API_URL=https://api.mangomeme.fun

# Optional public Telegram bot username for the "Return to Telegram" link (no secrets).
# VITE_TELEGRAM_BOT_USERNAME=ManGoMemeFunCommunityBot
