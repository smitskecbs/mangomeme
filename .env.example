# Private Solana RPC URL (Helius, QuickNode, Alchemy, etc.)
# Set this in your hosting provider — never commit the real value.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# ManGo Snake high-score API on Hetzner bot server (public URL, no secrets)
# Example: https://your-hetzner-host/snake-highscore
# Leave empty to disable score sharing in the game UI.
VITE_MANGO_HIGHSCORE_API_URL=
