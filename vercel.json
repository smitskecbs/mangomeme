{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/just-for-fun", "destination": "/mango-labs", "permanent": true },
    { "source": "/just-for-fun.html", "destination": "/mango-labs", "permanent": true }
  ],
  "rewrites": [
    { "source": "/mango-labs", "destination": "/mango-labs.html" },
    { "source": "/wallet-connect/:token", "destination": "/wallet-connect.html" },
    { "source": "/wallet-connect", "destination": "/wallet-connect.html" },
    { "source": "/presale/:token", "destination": "/presale.html" },
    { "source": "/presale", "destination": "/presale.html" }
  ]
}
